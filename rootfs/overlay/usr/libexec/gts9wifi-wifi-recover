#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Recover the WCN Wi-Fi endpoint when the chip powers on after the PCIe scan.
# If the boot chain hands the WCN6855 over cold, the PCIe link only trains
# after the root port's initial bus scan: the endpoint is never enumerated
# and ath11k has nothing to bind to.  Re-enumerate the root port so the
# bridge windows are sized with the device present.  No-op when the endpoint
# is already there (the normal, warm-handoff boot).
set -u

PORT=0000:00:00.0
EP=0000:01:00.0

# Give the chip time to appear on its own (late power-on, BT-rails-induced).
i=0
while [ "$i" -lt 45 ] && [ ! -e "/sys/bus/pci/devices/$EP" ]; do
	sleep 1
	i=$((i + 1))
done
[ -e "/sys/bus/pci/devices/$EP" ] && exit 0
[ -e "/sys/bus/pci/devices/$PORT" ] || exit 0

echo "gts9wifi-wifi-recover: endpoint missing, re-enumerating $PORT"
echo 1 > "/sys/bus/pci/devices/$PORT/remove"
sleep 1
echo 1 > /sys/bus/pci/rescan

i=0
while [ "$i" -lt 20 ] && [ ! -e "/sys/bus/pci/devices/$EP" ]; do
	sleep 1
	i=$((i + 1))
done
exit 0
