#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Device-specific controls for this port, shared by the boot unit
# (gts9wifi-device-control.service) and the gnome-gts9wifi GNOME Shell
# extension.  One table drives every command, so adding a control means adding
# a line here and nothing at all in the extension:
#
#   list           name, group, label, description and live value, tab separated
#   get NAME       live value, 0 or 1
#   set NAME 0|1   write the control now and remember it for the next boot
#   apply          write every saved value; this is the boot unit's job
#
# Nothing here needs privileges: the udev rule opens the touchscreen attribute
# to group video, and the state directory is handed to that same group, so the
# session user can run this directly.  The state directory is created here
# rather than by a tmpfiles.d entry on purpose: this port's root filesystem is
# owned by the build user, and systemd-tmpfiles refuses to touch any path under
# it ("Detected unsafe path transition"), so a tmpfiles entry would silently do
# nothing.
set -u

state_dir=/var/lib/gts9wifi

# name|group|label|description|default|sysfs path
CONTROLS='
double-tap-to-wake|Touchscreen|Double tap to wake|Wake the tablet from suspend by double tapping the screen.|1|/sys/bus/i2c/devices/10-0049/double_tap_to_wake
'

usage() {
	echo "usage: gts9wifi-device-control list|apply|get NAME|set NAME 0|1" >&2
	exit 2
}

ensure_state_dir() {
	mkdir -p "$state_dir" 2>/dev/null || true
	# Applied unconditionally so a directory created earlier by the session
	# user, or by an older version of this helper, is still brought to
	# root:video 0775.  Only root can do that; when the session user created
	# it instead it is already theirs, so a failure here is expected.
	chown root:video "$state_dir" 2>/dev/null || true
	chmod 0775 "$state_dir" 2>/dev/null || true
}

ensure_state_file() { # ensure_state_file <name> <default>
	ensure_state_dir
	[ -e "$state_dir/$1" ] && return 0
	printf '%s\n' "$2" >"$state_dir/$1" 2>/dev/null || true
	chown root:video "$state_dir/$1" 2>/dev/null || true
	chmod 0664 "$state_dir/$1" 2>/dev/null || true
}

live_value() { # live_value <path> <default>
	value=$(cat "$1" 2>/dev/null) || value=""
	case "$value" in
	0|1) printf '%s\n' "$value" ;;
	*) printf '%s\n' "$2" ;;
	esac
}

saved_value() { # saved_value <name> <default>
	value=$(cat "$state_dir/$1" 2>/dev/null) || value=""
	case "$value" in
	0|1) printf '%s\n' "$value" ;;
	*) printf '%s\n' "$2" ;;
	esac
}

command=${1:-list}
name_arg=${2:-}
value_arg=${3:-}

case "$command" in
list|apply|get|set) ;;
*) usage ;;
esac

matched=0
while IFS='|' read -r name group label description default path; do
	[ -n "$name" ] || continue
	if [ -n "$name_arg" ] && [ "$name_arg" != "$name" ]; then
		continue
	fi
	matched=1

	case "$command" in
	list)
		printf '%s\t%s\t%s\t%s\t%s\n' \
			"$name" "$group" "$label" "$description" \
			"$(live_value "$path" "$default")"
		;;
	get)
		live_value "$path" "$default"
		;;
	set)
		case "$value_arg" in
		0|1) ;;
		*)
			echo "gts9wifi-device-control: value must be 0 or 1" >&2
			exit 2
			;;
		esac
		if ! printf '%s\n' "$value_arg" >"$path" 2>/dev/null; then
			echo "gts9wifi-device-control: cannot write $path" >&2
			exit 1
		fi
		ensure_state_dir
		printf '%s\n' "$value_arg" >"$state_dir/$name" 2>/dev/null || true
		chmod 0664 "$state_dir/$name" 2>/dev/null || true
		;;
	apply)
		# The device the control lives on may still be probing at boot, so
		# give it a bounded moment to appear before giving up on it.
		tries=0
		while [ ! -e "$path" ] && [ "$tries" -lt 20 ]; do
			sleep 1
			tries=$((tries + 1))
			done
		ensure_state_file "$name" "$default"
		value=$(saved_value "$name" "$default")
		if ! printf '%s\n' "$value" >"$path" 2>/dev/null; then
			echo "gts9wifi-device-control: cannot write $path" >&2
		fi
		;;
	esac
done <<EOF
$CONTROLS
EOF

if [ "$matched" = 0 ] && [ -n "$name_arg" ]; then
	echo "gts9wifi-device-control: unknown control '$name_arg'" >&2
	exit 2
fi
