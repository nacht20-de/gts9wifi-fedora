From: Galaxy Tab S9 port contributors <noreply@localhost>
Subject: [PATCH] hexagonrpcd: support writable Samsung sensor registry cache

Samsung's SM8550 sensor firmware expects the registry cache rooted at
/mnt/vendor/persist/sensors/registry to be writable.  In particular it opens
sns_reg_version and temp.json with fopen("w"), rewrites them, and publishes
the result with a rename over the live registry group file.

Map that virtual directory to the device-specific HexagonFS prefix and add
fopen/fwrite/frename support to update this cache.  apps_std_fwrite packs
the fd and buffer length into the first input buffer (1 in num, 1 in buf),
matching the QAIC stub.  apps_std_frename arrives as extended method 33 and
renames within the mapped directory only; renames across HexagonFS mappings
or directly under the virtual root are refused.  The daemon remains confined
to the physical directory supplied with -R; this does not expose the real
Android persist partition.

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 06519f8..974a8cf 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -20,6 +20,7 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
 #include <stdio.h>
 #include <stdint.h>
 #include <string.h>
@@ -120,6 +121,43 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	if (inbufs[1].s < first_in->buf_size)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd,
+			      first_in->buf_size, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %u) -> %ld\n", first_in->fd,
+					 first_in->buf_size,
+					 ret);
+#endif
+
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -157,7 +195,7 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	struct apps_std_ctx *ctx = data;
 	uint32_t *out = outbufs[0].p;
 	char rw_mode;
-	int dirfd, fd;
+	int dirfd, fd, flags;
 
 	// The name and environment variable must also be NULL-terminated
 	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
@@ -166,10 +204,22 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EBADPARM;
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+	switch (rw_mode) {
+	case 'r':
+		flags = O_RDONLY;
+		break;
+	case 'w':
+		flags = O_WRONLY | O_CREAT | O_TRUNC;
+		break;
+	case 'a':
+		flags = O_WRONLY | O_CREAT | O_APPEND;
+		break;
+	default:
+		return AEE_EBADPARM;
+	}
+	if (strchr(inbufs[4].p, '+')) {
+		flags &= ~(O_RDONLY | O_WRONLY);
+		flags |= O_RDWR;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -188,7 +238,8 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EFAILED;
 	}
 
-	fd = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, inbufs[3].p);
+	fd = hexagonfs_openat_flags(ctx->fds, ctx->rootfd, dirfd,
+				    inbufs[3].p, flags);
 	if (fd < 0) {
 		fprintf(stderr, "Could not open %s: %s\n",
 				(const char *) inbufs[3].p,
@@ -350,6 +401,34 @@ static uint32_t apps_std_stat(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *old_name = inbufs[1].p;
+	const char *new_name = inbufs[2].p;
+	int ret;
+
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, ctx->adsp_library_dirfd,
+			       old_name, new_name);
+	if (ret < 0) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				old_name, new_name, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s)\n", old_name, new_name);
+#endif
+
+	return 0;
+}
+
 struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root)
 {
 	struct fastrpc_interface *iface;
@@ -419,7 +498,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -464,10 +546,15 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_frename_def,
+		.impl = apps_std_frename,
+	},
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 34,
 	.procs = apps_std_procs,
 };
diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..b74ebd0 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -20,6 +20,7 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdio.h>
@@ -139,7 +140,8 @@ err:
 	return ret;
 }
 
-int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+int hexagonfs_openat_flags(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			   const char *name, int flags)
 {
 	struct hexagonfs_fd *fd;
 	const char *curr = name;
@@ -169,7 +171,16 @@ int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const cha
 		} else if (!strcmp(segment, "..")) {
 			fd = pop_dir(fd, fds[rootfd]);
 		} else {
-			ret = fd->ops->openat(fd, segment, expect_dir, &fd);
+			if (!expect_dir && *curr == '\0' && flags != O_RDONLY) {
+				if (fd->ops->openat_flags == NULL)
+					ret = -EROFS;
+				else
+					ret = fd->ops->openat_flags(fd, segment,
+								   false, flags,
+								   &fd);
+			} else {
+				ret = fd->ops->openat(fd, segment, expect_dir, &fd);
+			}
 		}
 
 	next:
@@ -191,6 +202,94 @@ err:
 	return ret;
 }
 
+int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *name)
+{
+	return hexagonfs_openat_flags(fds, rootfd, dirfd, name, O_RDONLY);
+}
+
+static int split_parent(const char *path, char **dir_out, const char **base_out)
+{
+	const char *slash;
+	char *dir;
+	size_t n;
+
+	slash = strrchr(path, '/');
+	if (slash == NULL || slash[1] == '\0')
+		return -EINVAL;
+
+	n = slash - path;
+	if (n == 0)
+		return -EACCES;
+
+	dir = malloc(n + 1);
+	if (dir == NULL)
+		return -ENOMEM;
+
+	memcpy(dir, path, n);
+	dir[n] = 0;
+
+	*dir_out = dir;
+	*base_out = &slash[1];
+
+	return 0;
+}
+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *old_path, const char *new_path)
+{
+	struct hexagonfs_fd *old_dir, *new_dir;
+	char *old_parent = NULL, *new_parent = NULL;
+	const char *old_name, *new_name;
+	int oldno = -1, newno = -1;
+	int ret;
+
+	ret = split_parent(old_path, &old_parent, &old_name);
+	if (ret)
+		goto out;
+
+	ret = split_parent(new_path, &new_parent, &new_name);
+	if (ret)
+		goto out;
+
+	oldno = hexagonfs_openat(fds, rootfd, dirfd, old_parent);
+	if (oldno < 0) {
+		ret = oldno;
+		goto out;
+	}
+
+	newno = hexagonfs_openat(fds, rootfd, dirfd, new_parent);
+	if (newno < 0) {
+		ret = newno;
+		goto out;
+	}
+
+	old_dir = fds[oldno];
+	new_dir = fds[newno];
+
+	if (old_dir->ops != new_dir->ops) {
+		ret = -EXDEV;
+		goto out;
+	}
+
+	if (old_dir->ops->rename == NULL) {
+		ret = -EROFS;
+		goto out;
+	}
+
+	ret = old_dir->ops->rename(old_dir, old_name, new_dir, new_name);
+
+out:
+	if (newno >= 0)
+		hexagonfs_close(fds, newno);
+	if (oldno >= 0)
+		hexagonfs_close(fds, oldno);
+	free(old_parent);
+	free(new_parent);
+
+	return ret;
+}
+
 int hexagonfs_close(struct hexagonfs_fd **fds, int fileno)
 {
 	struct hexagonfs_fd *fd;
@@ -244,6 +343,24 @@ ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void
 	return fd->ops->read(fd, size, ptr);
 }
 
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size,
+			const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -ENOSYS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t ent_size, char *ent)
 {
 	struct hexagonfs_fd *fd;
