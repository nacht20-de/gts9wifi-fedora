@@ -126,6 +127,14 @@ err:
 	return ret;
 }
 
+static int mapped_openat(struct hexagonfs_fd *dir,
+			 const char *segment,
+			 bool expect_dir,
+			 struct hexagonfs_fd **out)
+{
+	return mapped_openat_flags(dir, segment, expect_dir, O_RDONLY, out);
+}
+
 static ssize_t mapped_read(struct hexagonfs_fd *fd, size_t size, void *out)
 {
 	struct mapped_ctx *ctx = fd->data;
@@ -138,6 +147,35 @@ static ssize_t mapped_read(struct hexagonfs_fd *fd, size_t size, void *out)
 	return ret;
 }
 
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size,
+			    const void *data)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret;
+
+	ret = write(ctx->fd, data, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+static int mapped_rename(struct hexagonfs_fd *old_dir,
+			 const char *old_name,
+			 struct hexagonfs_fd *new_dir,
+			 const char *new_name)
+{
+	struct mapped_ctx *old_ctx = old_dir->data;
+	struct mapped_ctx *new_ctx = new_dir->data;
+	int ret;
+
+	ret = renameat(old_ctx->fd, old_name, new_ctx->fd, new_name);
+	if (ret < 0)
+		return -errno;
+
+	return 0;
+}
+
 static int mapped_readdir(struct hexagonfs_fd *fd, size_t size, char *out)
 {
 	struct mapped_ctx *ctx = fd->data;
